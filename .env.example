# このアプリに入るためのパスワード(長めのものを推奨)
APP_PASSWORD=

# Google Cloud で作成した OAuth クライアント(種類: ウェブアプリケーション)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 任意: 暗号化と署名に使う秘密の文字列(32文字以上)。未設定なら上の値から自動で作る
# SESSION_SECRET=

# 任意: 公開URLを固定したい場合(例: https://example.vercel.app)
# APP_URL=

# 任意: 連携情報をサーバー側に保存する場合(Upstash Redis)。
# 未設定なら、連携情報は暗号化して端末ごとのCookieに保存します。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
